# Resend API key (https://resend.com/api-keys). Without it the contact form returns an error
# and the visitor is pointed to the email/LinkedIn links instead.
RESEND_API_KEY=

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=pouzadap@gmail.com

# Sender. "onboarding@resend.dev" works without a verified domain, but only delivers
# to the email of the Resend account owner. Swap for your own domain later.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Public URL, used for Open Graph (LinkedIn preview). Vercel fills this automatically in production.
NEXT_PUBLIC_SITE_URL=
